<?xml version="1.0" encoding="utf-8"?>
<!--
  The game save lives in SharedPreferences (Capacitor Preferences), so that is
  what Android Auto Backup should carry to a new device.

  Naming an <include> makes the backup opt-in: everything not listed is already
  excluded, so the WebView's caches and databases (regenerable scratch space)
  are left out without needing explicit <exclude> entries.
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
</full-backup-content>
